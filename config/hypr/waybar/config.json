{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 2,
  "reload_style_on_change": true,
  "modules-left": [
    "cffi/bar-options",
    "custom/launcher",
    "hyprland/workspaces",
    "cffi/new-workspace",
    "custom/keys",
    "cffi/workspace-mode",
    "custom/updates",
    "cffi/app-pins"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "custom/recording",
    "cpu",
    "memory",
    "custom/temperature",
    "disk",
    "custom/network",
    "group/audio",
    "pulseaudio#microphone",
    "idle_inhibitor",
    "custom/clipboard",
    "custom/notifications",
    "tray",
    "clock",
    "custom/power"
  ],
  "cffi/bar-options": {
    "module_path": "@HOME@/.config/hypr/waybar/options/options.so"
  },
  "custom/launcher": {
    "format": "\udb82\udcc7  Apps",
    "tooltip-format": "Application launcher \u00b7 Super + Space",
    "on-click": "~/.config/hypr/scripts/launcher.sh --from-bar",
    "on-click-right": "$HOME/.config/hypr/scripts/control-center.sh --tab system"
  },
  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "format-icons": {
      "xetal-startup": "Welcome",
      "magic": "Stash"
    },
    "all-outputs": false,
    "show-special": true,
    "special-visible-only": false,
    "on-click": "activate",
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": true,
      "format": "{icon}",
      "icon-size": 21,
      "on-click-window": "python3 $HOME/.config/hypr/scripts/activate-window.py {address}",
      "icon-theme": [
        "Papirus-Dark",
        "Adwaita"
      ],
      "ignore-list": [
        "^xetal-startup-(info|matrix|clock|hero|projects)$"
      ],
      "active-window-position": "none"
    },
    "active-only": false,
    "persistent-only": false,
    "move-to-monitor": false,
    "sort-by": "number"
  },
  "custom/keys": {
    "format": "\udb80\udf0c  Keys",
    "tooltip-format": "Hotkey editor \u00b7 Super + K",
    "on-click": "$HOME/.config/hypr/scripts/control-center.sh --tab hotkeys"
  },
  "cffi/workspace-mode": {
    "module_path": "@HOME@/.config/hypr/waybar/workspaces/mode.so"
  },
  "cffi/app-pins": {
    "module_path": "@HOME@/.config/hypr/waybar/pins/pins.so"
  },
  "mpris": {
    "interval": 1,
    "format": "{player_icon} {dynamic} [{position}]",
    "format-paused": "{status_icon} {dynamic} [{position}]",
    "tooltip-format": "{title}\n{artist}\n{player} ({status}) \u00b7 {position}",
    "player-icons": {
      "default": "\uf001",
      "firefox": "\uf269",
      "spotify": "\uf1bc"
    },
    "status-icons": {
      "paused": "\uf04c",
      "playing": "\uf04b"
    },
    "title-len": 20,
    "artist-len": 20,
    "dynamic-order": [
      "title",
      "artist"
    ],
    "dynamic-len": 20,
    "max-length": 36,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous"
  },
  "cpu": {
    "format": "\uf4bc {usage}%",
    "interval": 3,
    "tooltip": true,
    "on-click": "$HOME/.config/hypr/scripts/control-center.sh --tab system",
    "on-click-right": "kitty --config $HOME/.config/hypr/kitty.conf -e htop"
  },
  "memory": {
    "format": "\uefc5 {used:0.0f}G",
    "interval": 3,
    "tooltip-format": "Memory: {used:0.1f} / {total:0.1f} GiB ({percentage}%)",
    "on-click": "$HOME/.config/hypr/scripts/control-center.sh --tab system"
  },
  "disk": {
    "path": "@HOME@",
    "format": "\udb80\udeca {percentage_used}%",
    "tooltip-format": "Home disk: {free} free / {total}",
    "interval": 30,
    "on-click": "$HOME/.config/hypr/scripts/control-center.sh --tab system"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "\udb81\udf5f Muted",
    "format-icons": {
      "headphone": "\udb80\udecb",
      "headset": "\udb80\udece",
      "default": [
        "\udb81\udd7f",
        "\udb81\udd80",
        "\udb81\udd7e"
      ]
    },
    "scroll-step": 3,
    "max-volume": 100,
    "tooltip-format": "{desc}\nScroll: volume \u00b7 Right-click: mute\nClick: Audio settings",
    "on-click": "$HOME/.config/hypr/scripts/control-center.sh --tab audio",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-muted": "{format_source}",
    "format-source": "\udb80\udf6c {volume}%",
    "format-source-muted": "\udb80\udf6d",
    "tooltip-format": "Microphone\nScroll: input level \u00b7 Right-click: mute\nClick: input devices",
    "on-click": "$HOME/.config/hypr/scripts/control-center.sh --tab audio",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 3%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 3%-"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\udb80\udd76",
      "deactivated": "\udb81\udeca"
    },
    "tooltip-format-activated": "Keep-awake enabled \u00b7 Click to allow idle",
    "tooltip-format-deactivated": "Click to keep this session awake"
  },
  "custom/clipboard": {
    "format": "\uf0ea",
    "tooltip-format": "Clipboard history \u00b7 Super+Shift+V",
    "on-click": "$HOME/.config/hypr/scripts/clipboard-history.sh --from-bar"
  },
  "custom/notifications": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "\udb84\udd6b",
      "none": "\udb80\udc9a",
      "dnd-notification": "\udb80\udc9b",
      "dnd-none": "\udb80\udc9b",
      "inhibited-notification": "\udb80\udc9b",
      "inhibited-none": "\udb80\udc9b",
      "dnd-inhibited-notification": "\udb80\udc9b",
      "dnd-inhibited-none": "\udb80\udc9b"
    },
    "tooltip": false,
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d",
    "restart-interval": 5
  },
  "tray": {
    "icon-size": 19,
    "spacing": 8,
    "show-passive-items": true
  },
  "clock": {
    "format": "{:%a %d %b  %I:%M %p}",
    "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
    "interval": 1,
    "tooltip": false,
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<span color='#75ddd0'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    },
    "on-click": "$HOME/.config/hypr/scripts/quick-panel.sh clock",
    "on-click-right": "$HOME/.config/hypr/scripts/control-center.sh --tab calendar"
  },
  "custom/power": {
    "format": "\u23fb",
    "tooltip-format": "Session and power controls",
    "on-click": "$HOME/.config/hypr/scripts/quick-panel.sh power",
    "on-click-right": "hyprlock --config $HOME/.config/hypr/hyprlock.conf"
  },
  "group/audio": {
    "orientation": "inherit",
    "modules": [
      "pulseaudio",
      "pulseaudio/slider",
      "custom/audio-mixer"
    ]
  },
  "custom/audio-mixer": {
    "format": "\udb81\udd7e  Mixer",
    "tooltip-format": "Open the app mixer popup\nMain volume, app volumes and output devices\nRight-click: Audio settings",
    "on-click": "$HOME/.config/hypr/scripts/quick-panel.sh audio",
    "on-click-right": "$HOME/.config/hypr/scripts/control-center.sh --tab audio"
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },
  "cffi/new-workspace": {
    "module_path": "@HOME@/.config/hypr/waybar/workspaces/controls.so"
  },
  "custom/temperature": {
    "exec": "$HOME/.config/hypr/scripts/panel-status.py temperature",
    "return-type": "json",
    "interval": 5,
    "on-click": "$HOME/.config/hypr/scripts/control-center.sh --tab system"
  },
  "custom/updates": {
    "exec": "python3 $HOME/.config/hypr/updates/service.py --status",
    "return-type": "json",
    "format": "{text}",
    "hide-empty-text": true,
    "interval": 5,
    "tooltip": true,
    "on-click": "$HOME/.config/hypr/scripts/desktop-updates.sh"
  },
  "custom/recording": {
    "exec": "python3 ~/.config/hypr/recording/service.py --bar",
    "return-type": "json",
    "interval": 1,
    "on-click": "python3 ~/.config/hypr/recording/service.py --stop",
    "on-click-right": "~/.config/hypr/scripts/control-center.sh --tab capture"
  },
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "custom/network": {
    "exec": "$HOME/.config/hypr/scripts/panel-status.py network",
    "return-type": "json",
    "format": "{text}",
    "interval": 5,
    "on-click": "$HOME/.config/hypr/scripts/quick-panel.sh network"
  }
}
