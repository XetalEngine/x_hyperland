{
  "version": 1,
  "shell": "bash",
  "enhanced": true,
  "syntax_highlighting": true,
  "autosuggestions": true,
  "completion_menu": true,
  "completion_fuzzy": true,
  "completion_ignore_case": true,
  "suggestion_delay": 150,
  "keymap": "emacs",
  "history_enabled": true,
  "history_size": 20000,
  "history_ignore_space": true,
  "history_ignore_duplicates": true,
  "history_share": true,
  "follow_theme_font": true,
  "font_family": "monospace",
  "font_size": 11.0,
  "padding": 10,
  "opacity": 100,
  "cursor_shape": "block",
  "cursor_blink": true,
  "cursor_trail": true,
  "scrollback_lines": 20000,
  "pager_history_mb": 16,
  "scrollbar": "always",
  "tab_style": "powerline",
  "tab_edge": "top",
  "remember_window_size": false,
  "copy_on_select": false,
  "audio_bell": false,
  "confirm_close": true
}
